{
  "expo": {
    "name": "Turismo Sincelejo",
    "slug": "turismo-sincelejo-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "turismosincelejo",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.juanavilez.turismosincelejo",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.juanavilez.turismosincelejo"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a Turismo Sincelejo acceder a tus fotos para subir imágenes de los lugares.",
          "cameraPermission": "Permite a Turismo Sincelejo usar la cámara para fotografiar los lugares."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "48649f46-80a5-4e66-9e89-f8f6c39b271e"
      }
    },
    "owner": "juhancamilo"
  }
}
